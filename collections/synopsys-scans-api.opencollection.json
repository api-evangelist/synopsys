{
  "opencollection": "1.0.0",
  "info": {
    "name": "Synopsys Cloud OpenLink Entitlements Scans API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Scans",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Scans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.synopsys.com/openlink/v1/jobs/runs",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "query"
              },
              {
                "name": "branchId",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieves a list of scan runs with their status and results."
        },
        {
          "info": {
            "name": "Get Scan Run",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.synopsys.com/openlink/v1/jobs/runs/:runId",
            "params": [
              {
                "name": "runId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves details for a specific scan run."
        }
      ]
    }
  ],
  "bundled": true
}